+/// Receives one event for every transcript operation the PCS verifier performs.
+///
+/// The projection is deliberately narrow: proof-of-work verification, the nonce
+/// absorption that follows it, and the two draws that depend on it. FRI-internal
+/// folding challenges and commitment absorptions are not reported, so a consumer
+/// must treat the recorded trace as a projection rather than the whole transcript.
+#[cfg(feature = "airlock-transcript")]
+pub trait TranscriptSink {
+    /// Records that the nonce was read as a canonical fixed-width value.
+    ///
+    /// This is the only validation the verifier performs on the nonce before it
+    /// reaches the channel: a `u64` read is in-domain and canonically encoded by
+    /// construction. The substantive check is the proof-of-work verification
+    /// reported next, which at zero configured bits accepts every nonce.
+    fn record_nonce_encoding(&mut self, label: &str, nonce: u64);
+    /// Records the exact nonce checked by proof-of-work verification.
+    fn record_pow_verification(&mut self, label: &str, bits: u32, nonce: u64, accepted: bool);
+    /// Records an absorption of a proof-of-work nonce.
+    fn record_nonce_absorption(&mut self, label: &str, nonce: u64);
+    /// Records drawn query positions and the domain they index.
+    fn record_query_draw(&mut self, label: &str, domain_size: usize, positions: &[usize]);
+}
